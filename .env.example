# Environment Variables — PondFlow
# Salin file ini menjadi .env.local dan isi nilainya

# ============================================================
# SELF-HOSTED SQLITE
# ============================================================
PONDFLOW_DATA_DIR=./data
AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Password reset email — sengaja nonaktif sampai mailer dikonfigurasi
PONDFLOW_MAIL_ENABLED=false
PONDFLOW_SMTP_HOST=smtp.example.com
PONDFLOW_SMTP_PORT=587
PONDFLOW_SMTP_USER=
PONDFLOW_SMTP_PASSWORD=
PONDFLOW_MAIL_FROM=PondFlow <noreply@example.com>

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
# Dapatkan GRATIS dari: https://aistudio.google.com/app/apikey
# JANGAN tambahkan NEXT_PUBLIC_ — hanya digunakan di server (API route)
GEMINI_API_KEY=AIzaSy...

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Link APK Android pada halaman landing. Ganti saat membuat release baru.
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/rifkinasss/Pond-Flow/releases/download/v1.0.1/PondFlow-v1.0.1-release.apk
NEXT_PUBLIC_ANDROID_APK_VERSION=1.0.1
NEXT_PUBLIC_RELEASE_PAGE_URL=https://github.com/rifkinasss/Pond-Flow/releases/tag/v1.0.1
